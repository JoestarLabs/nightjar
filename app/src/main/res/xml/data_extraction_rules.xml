<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ (dataExtractionRules).

    Cloud backup: DISABLED — Nightjar does not sync preferences to Google Account.
    Device transfer: ENABLED — timer duration and commitment-mode preferences are
    transferred when a user moves to a new phone, which is a harmless convenience.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Intentionally empty: no data is backed up to Google Account. -->
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore/nightjar_timer_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>