<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API < 31 (fullBackupContent).
    Cloud backup is intentionally disabled for Nightjar — the app stores only ephemeral
    timer preferences and there is no meaningful state to restore across accounts.
    Device-to-device transfer is handled by data_extraction_rules.xml (API 31+).
-->
<full-backup-content>
    <exclude domain="file" path="." />
</full-backup-content>